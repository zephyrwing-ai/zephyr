---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getPublishedEntries } from "@/lib/content";
const entries = await getPublishedEntries();
---
<SiteLayout title="Page not found — Zephyr" entries={entries}>
  <section class="not-found"><p class="eyebrow">404</p><h1>Page not found.</h1><a class="text-link" href="/">Back home <span aria-hidden="true">→</span></a></section>
</SiteLayout>
