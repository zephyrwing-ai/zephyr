---
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";
import type { MarkdownHeading } from "astro";
import MobileMenu from "@/components/MobileMenu";
import Sidebar from "@/components/Sidebar.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { sections, site, type SectionId } from "@/config/site";
import { getSectionGroups, type Entry } from "@/lib/content";
import { url } from "@/lib/paths";

interface Props {
  title?: string;
  description?: string;
  entries: Entry[];
  currentSection?: SectionId;
  headings?: MarkdownHeading[];
}
const { title = site.title, description = site.description, entries, currentSection, headings = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const groups = currentSection ? getSectionGroups(currentSection, entries) : [];
const socialLinks = [
  { name: "X", href: site.x },
  { name: "GitHub", href: site.github },
];
const canonical = Astro.site ? new URL(currentPath, Astro.site).href : undefined;
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={Astro.site ? "index, follow" : "noindex, follow"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body data-elastic-root>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="elastic-layout">
    <div class="elastic-scroll" data-elastic-scroll>
    <div data-elastic-content>
    <header class="site-header" data-site-header>
      <div class="header-inner">
        <a class="wordmark" href={url("/")} aria-label="Zephyr home">Zephyr</a>
        <nav class="top-navigation" aria-label="Main navigation">{sections.map((section) => (
          <a href={url(`/${section.id}/`)} class:list={{ "is-active": currentSection === section.id }} aria-current={currentSection === section.id ? "true" : undefined}>{section.label}</a>
        ))}</nav>
        <div class="header-actions">
          {socialLinks.map((link) => link.href
            ? <a class="social-link" href={link.href} target="_blank" rel="noreferrer" aria-label={`${link.name} (opens in a new tab)`}>{link.name}</a>
            : <span class="social-link social-placeholder" aria-label={`${link.name} link not added`}>{link.name}</span>
          )}
          <a class="contact-link" href={`mailto:${site.email}`}>Contact</a>
          <MobileMenu groups={groups} currentPath={currentPath} currentSection={currentSection} client:load />
        </div>
      </div>
    </header>
    <div class="site-shell">
      {groups.length > 0 && <Sidebar groups={groups} currentPath={currentPath} />}
      <main id="main-content" class="page-main" tabindex="-1">
        <slot />
        <footer class="site-footer"><span>© {new Date().getFullYear()} Zephyr</span></footer>
      </main>
    </div>
    </div>
    <TableOfContents headings={headings} />
    </div>
    </div>
    <script>import "@/scripts/reading"; import "@/scripts/elastic-scroll"; import "@/scripts/outline-dock";</script>
  </body>
</html>
