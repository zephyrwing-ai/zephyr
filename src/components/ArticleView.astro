---
import { render } from "astro:content";
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getSection } from "@/config/site";
import { getPublishedEntries, type Entry } from "@/lib/content";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const entries = await getPublishedEntries();
const currentSection = getSection(entry.data.section);
const { Content, headings } = await render(entry);
---

<SiteLayout title={`${entry.data.title} — Zephyr`} description={entry.data.description} entries={entries} currentSection={currentSection} headings={headings}>
  <article class="article-prose" data-article-body>
    <h1 class="article-title">{entry.data.title}</h1>
    <Content />
  </article>
</SiteLayout>
