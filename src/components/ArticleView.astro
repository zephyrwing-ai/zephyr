---
import { render } from "astro:content";
import "@fontsource-variable/manrope";
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getSection } from "@/config/site";
import { getPublishedEntries, type Entry } from "@/lib/content";

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const entries = await getPublishedEntries();
const currentSection = getSection(entry.data.section);
const { Content, headings } = await render(entry);
---

<SiteLayout title={`${entry.data.title} — Zephyr`} description={entry.data.description} entries={entries} currentSection={currentSection} headings={headings}>
  <h1 class="sr-only">{entry.data.title}</h1>
  <article
    class:list={["article-prose", { "article-prose--manrope": entry.data.typeface === "manrope" }]}
    data-article-body
  >
    <Content />
  </article>
</SiteLayout>
