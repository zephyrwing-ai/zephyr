---
import SiteLayout from "@/layouts/SiteLayout.astro";
import EntryList from "@/components/EntryList.astro";
import type { Section } from "@/config/site";
import { getPublishedEntries, getSectionGroups, getEntryHref } from "@/lib/content";

interface Props {
  section: Section;
}

const { section } = Astro.props;
const entries = await getPublishedEntries();
const sectionEntries = entries.filter((entry) => entry.data.section === section.id);
const groups = getSectionGroups(section.id, sectionEntries);
const headings = section.id === "elsewhere"
  ? groups.map((group, index) => ({ depth: 2, slug: `group-${index}`, text: group.label }))
  : [];
---

<SiteLayout title={`${section.label} — Zephyr`} description={section.description} entries={entries} currentSection={section} headings={headings}>
  <div data-article-body>
    <h1 class="sr-only">{section.label}</h1>
    {section.id === "elsewhere" ? groups.map((group, index) => (
      <section class="collection-group">
        <div class="section-heading"><h2 id={`group-${index}`}>{group.label}</h2><span class="collection-count">{group.items.length}</span></div>
        <EntryList entries={sectionEntries.filter((entry) => group.items.some((item) => item.href === getEntryHref(entry)))} showSection={false} />
      </section>
    )) : <EntryList entries={sectionEntries} showSection={false} />}
  </div>
</SiteLayout>
