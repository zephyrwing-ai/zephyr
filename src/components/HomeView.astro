---
import { ArrowUpRight, ArrowRight } from "lucide-react";
import SiteLayout from "@/layouts/SiteLayout.astro";
import EntryList from "@/components/EntryList.astro";
import { ui } from "@/config/site";
import { getPublishedEntries, getEntryHref } from "@/lib/content";
import { url } from "@/lib/paths";

const copy = ui.home;
const entries = await getPublishedEntries();
const latest = entries.slice(0, 3);
const selectedWork = entries
  .filter((entry) => entry.data.section === "work")
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const featuredEntry = entries.find((entry) => entry.data.section === "weekly" && entry.data.featured) || entries[0];
---

<SiteLayout entries={entries}>
  <div data-article-body>
    <section class="home-hero">
      <h1>{copy.heroLead}<br /><span>{copy.heroTail}</span></h1>
      <a href={featuredEntry ? getEntryHref(featuredEntry) : url("/weekly/")} class="text-link hero-link">{copy.readLatest} <ArrowRight size={16} aria-hidden="true" /></a>
    </section>
    <section class="home-section">
      <div class="section-heading"><h2 id="recent-notes">{copy.recentNotes}</h2><a href={url("/weekly/")} class="quiet-link">{copy.browseWeekly} <ArrowUpRight size={14} aria-hidden="true" /></a></div>
      <EntryList entries={latest} />
    </section>
    {selectedWork.length > 0 && (
      <section class="home-section">
        <div class="section-heading"><h2 id="selected-work">{copy.selectedWork}</h2><a href={url("/work/")} class="quiet-link">{copy.allWork} <ArrowUpRight size={14} aria-hidden="true" /></a></div>
        <div class="project-grid">{selectedWork.map((entry) => (
          <a class="project-preview" href={getEntryHref(entry)}>
            {entry.data.cover && <div class="project-image"><img src={url(entry.data.cover.src)} alt={entry.data.cover.alt} width={entry.data.cover.width} height={entry.data.cover.height} loading="lazy" /></div>}
            <div class="project-preview-title"><h3>{entry.data.title}</h3><ArrowUpRight size={17} aria-hidden="true" /></div>
            <p>{entry.data.description}</p>
            <span class="project-kind">{entry.data.topic || copy.independentWork}</span>
          </a>
        ))}</div>
      </section>
    )}
  </div>
</SiteLayout>
