---
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[] }
const { headings } = Astro.props;
const outline = headings.filter((heading) => heading.depth === 2);
---
{outline.length > 0 && (
  <aside class="page-outline"><div class="outline-inner">
    <nav aria-label="Article sections"><ul>{outline.map((heading) => (
      <li><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>
    ))}</ul></nav>
  </div></aside>
)}
