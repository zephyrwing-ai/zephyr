---
import { ArrowUpRight } from "lucide-react";
import { formatEntryDate, getEntryHref, type Entry } from "@/lib/content";
import { getSection } from "@/config/site";
interface Props { entries: Entry[]; showSection?: boolean; showDate?: boolean }
const { entries, showSection = true, showDate = true } = Astro.props;
---
<div class="entry-list">
  {entries.map((entry) => (
    <a class="entry-row" href={getEntryHref(entry)}>
      <div class="entry-row-content">
        {(showSection || showDate) && <div class="entry-meta">
          {showSection && <span>{getSection(entry.data.section)?.label}</span>}
          {showDate && <time datetime={entry.data.publishedAt}>{formatEntryDate(entry)}</time>}
        </div>}
        <h3>{entry.data.title}</h3>
        <p>{entry.data.description}</p>
      </div>
      <ArrowUpRight className="entry-arrow" size={19} aria-hidden="true" />
    </a>
  ))}
</div>
