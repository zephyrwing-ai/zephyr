---
import type { MarkdownHeading } from "astro";
import SiteLayout from "@/layouts/SiteLayout.astro";
import type { Entry } from "@/lib/content";

interface Props {
  pageTitle: string;
  description: string;
  eyebrow: string;
  titleLines: readonly string[];
  lede: string;
  glyphLines: readonly string[];
  meta: readonly string[];
  fontClass: string;
  entries: Entry[];
  headings: MarkdownHeading[];
}

const {
  pageTitle,
  description,
  eyebrow,
  titleLines,
  lede,
  glyphLines,
  meta,
  fontClass,
  entries,
  headings,
} = Astro.props;
---

<SiteLayout
  title={pageTitle}
  description={description}
  entries={entries}
  headings={headings}
  noindex
>
  <div class:list={["type-specimen", "article-prose", fontClass]} data-article-body>
    <header class="type-specimen__hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="type-specimen__title">
        {titleLines.map((line) => <span class="type-specimen__title-line">{line}</span>)}
      </h1>
      <p class="type-specimen__lede">{lede}</p>
      <p class="type-specimen__glyphs" aria-label={`${titleLines.join(" ")} glyph sample`}>
        {glyphLines.map((line) => <span class="type-specimen__glyph-line">{line}</span>)}
      </p>
      <div class="type-specimen__meta">
        {meta.map((item) => <span>{item}</span>)}
      </div>
    </header>

    <slot />
  </div>
</SiteLayout>
